# SECRETS SERVEUR — à saisir dans les tableaux de bord, JAMAIS dans le code ni sur GitHub.

# Cloudflare Pages > Settings > Variables and Secrets (type: Secret)
TURNSTILE_SECRET=

# Vercel > Project > Settings > Environment Variables (API Check-Ban)
# Domaine Cloudflare Pages autorisé à appeler l'API Vercel (CORS)
BANCHECK_CORS_ORIGIN=https://TON-PROJET.pages.dev,capacitor://localhost,http://localhost,https://localhost
# Optionnel
# BANCHECK_API_URL=https://inconnu-check-ban-api.onrender.com
# BANCHECK_TIMEOUT_MS=25000
